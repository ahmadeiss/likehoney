{
  "name": "@likehoney/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data access for Neon PostgreSQL via Drizzle ORM. Queries, transactions and schema live here; only the backend may use this package.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:runtime-check": "node scripts/runtime-check.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed:dev": "node scripts/seed-dev.mjs",
    "db:bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "db:reset:admin-password": "node scripts/reset-admin-password.mjs",
    "db:create:production-admin": "node scripts/create-production-admin.mjs",
    "db:bootstrap:production-rbac": "node scripts/bootstrap-production-rbac.mjs",
    "db:seed:production-catalog": "node scripts/seed-production-catalog.mjs",
    "db:cleanup:dev-fixtures": "node scripts/cleanup-dev-fixtures.mjs",
    "db:reset:production-data": "node scripts/reset-production-data.mjs",
    "test": "node --test scripts/connection-target.test.mjs scripts/rbac-bootstrap.test.mjs scripts/catalog-seed.test.mjs scripts/production-snapshot.test.mjs scripts/production-audit.test.mjs scripts/resume-plan.test.mjs scripts/r2-endpoint.test.mjs scripts/reset-production-data.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@likehoney/config": "workspace:*",
    "@types/node": "^24",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
