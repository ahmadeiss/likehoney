# Like Honey — environment variable template
# Never commit real values. Copy this file to .env and fill in locally.

# Neon PostgreSQL connection URL — server-side only, never the frontend.
# Development value lives in the ignored local files:
#   - packages/db/.env        (read by Drizzle tooling)
#   - apps/api/.dev.vars      (read by the local API Worker)
# Production is injected in Cloudflare at deploy time.
DATABASE_URL=

# Cloudflare account / R2 (media storage).
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=

# Staff session lifetime (hours). Defaults to 12 if unset.
SESSION_HOURS=

# Force Secure on the session cookie. Leave unset in production (Secure on);
# set explicit values only for development.
SECURE_COOKIES=